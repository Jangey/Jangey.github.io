<head>
    <meta charset="utf-8">
    <!-- Mobile Devide view -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">

    <!-- Title -->
    <%
    var title = [];
    if (page.current > 1) title.push(__('page', page.current));
    if (page.title) title.push(page.title);
    if (page.category) title.push(page.category);
    if (page.tag) title.push(page.tag);
    if (page.archive) {
        if (page.year) title.push(__('archive_b', page.year + (page.month ? '/' + page.month : '')));
        else title.push(__('Archives'));
    }
    title.push(config.title);
    %>
    <title><%= title.join(' | ') %></title>

    <!-- Favicon -->
    <link rel="icon" href="<%- asset_version('favicon.ico') %>" sizes="32x32">
    <link rel="icon" href="<%- asset_version('favicon.svg') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%- asset_version('apple-touch-icon.png') %>">

    <!-- Pure CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-alpha.6/css/bootstrap.min.css" integrity="sha384-rwoIResjU2yc3z8GV/NPeZWAv56rSmLldC3R/AZzGRnGxQQKnKkoFVhFQhNUwEyJ" crossorigin="anonymous">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css?family=Great+Vibes" rel="stylesheet">
   <!-- Custom CSS -->
    <link rel="stylesheet" href="<%- asset_version('css/styles.css') %>">

 </head>